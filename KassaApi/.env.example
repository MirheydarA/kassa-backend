# Bu faylı `.env` adı ilə kopyala və real dəyərləri doldur. `.env` git-ə commit edilmir.
#
# Güclü dəyərlər generasiya etmək üçün:
#   openssl rand -base64 32   (MSSQL_SA_PASSWORD, JWT_KEY, ADMIN_PASSWORD üçün)

MSSQL_SA_PASSWORD=
JWT_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGIN=http://localhost:5173
